<?xml version="1.0" encoding="utf-8"?><!--
   Backups must never carry the auth token. `auth_preferences` holds the bearer token
   (encrypted with an AndroidKeyStore key that does not leave the device, so a restored
   copy would be useless anyway) and nothing here is worth restoring across devices.
   See https://developer.android.com/guide/topics/data/autobackup
   Note: ignored on API 31+, which uses data_extraction_rules.xml instead.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/" />
</full-backup-content>
