DATABASE_URL=postgresql://postgres:PASSWORD@db.example.com:6543/postgres
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iiitnr_inventory_test

PORT=4000

# Generate JWT_SECRET and DB_PASSWORD with "openssl rand -hex 32"
JWT_SECRET=CHANGE_ME
DB_USER=iiitnr
DB_PASSWORD=CHANGE_ME

# Optional — override the drizzle migrations directory (default: backend/src/drizzle)
#MIGRATIONS_FOLDER=


# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_EXTRA_IDS=
# Web (WasmJs) OAuth client — read by `just deploy-web` at build time
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

ALLOWED_EMAIL_DOMAIN=@example.com
ALLOW_UNVERIFIED_EMAIL=false

# CORS — comma-separated list of origins
ALLOWED_ORIGINS=

MAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Inventory Mgmt System <inventory@example.com>"

# Seed admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME
ADMIN_NAME=Inventory Admin

# Set to 1 to stop entrypoint.ts from running scripts/seed.ts on boot
#SKIP_SEED=1