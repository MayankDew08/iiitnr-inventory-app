inventory.iiitnr.ac.in {
    tls /etc/caddy/certs/acnew.pem /etc/caddy/certs/ac.key

    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        -Server
    }

    handle_path /api/* {
        reverse_proxy backend:4000
    }

    handle /download/* {
        reverse_proxy backend:4000
    }

    handle {
        root * /srv/web
        try_files {path} /index.html

        @immutable path_regexp \.(js|mjs|wasm|css|png|jpg|jpeg|svg|ico|webp|avif|woff2?)$
        header @immutable Cache-Control "public, max-age=31536000, immutable"

        @nocache path /index.html /manifest.webmanifest /sw.js
        header @nocache Cache-Control "no-cache"

        file_server
    }

    log {
        output file /var/log/caddy/access.log {
            roll_size 100mb
            roll_keep 10
            roll_keep_for 720h
        }
        format json
    }
}