{
  "name": "@iiitnr/backend",
  "version": "1.17.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run migrate && bun --watch src/server.ts",
    "build": "tsc",
    "start": "bun run migrate && bun run src/server.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier -w .",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "migrate": "bun run src/index.ts",
    "seed": "bun run scripts/seed.ts",
    "create:user": "bun run scripts/create-user.ts",
    "migrate:backup": "bun run scripts/migrate-with-backup.ts",
    "test": "bun test --parallel=1"
  },
  "dependencies": {
    "@fastify/cors": "11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "10.2.7",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "ajv": "^8.20.0",
    "bcryptjs": "3.0.3",
    "dotenv": "18.0.10",
    "drizzle-orm": "^0.45.4",
    "fastify": "5.12.8",
    "fastify-sse-v2": "^4.2.2",
    "google-auth-library": "^11.3.4",
    "it-pushable": "^3.2.4",
    "nodemailer": "^10.5.0",
    "pg": "8.23.1",
    "xss": "^1.0.17"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.18.0",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "^17.14.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "resolutions": {
    "@types/pg": "8.18.0"
  }
}
